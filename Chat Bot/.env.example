# ── Azure OpenAI: embeddings (for ingestion + query) ──────────────────────────
SOPS_EMBED_ENDPOINT=https://alhmra-resource.cognitiveservices.azure.com
SOPS_EMBED_DEPLOYMENT=text-embedding-3-small
SOPS_EMBED_API_VERSION=2023-05-15
SOPS_EMBED_KEY=

# ── Azure OpenAI: chat (for grounded answers) ─────────────────────────────────
SOPS_CHAT_ENDPOINT=https://quality-project-resource.openai.azure.com
SOPS_CHAT_DEPLOYMENT=gpt-5.2-chat-2
SOPS_CHAT_API_VERSION=2024-10-21
SOPS_CHAT_KEY=

# ── Vector store: local Chroma (no database server needed) ────────────────────
# Persisted on disk under the Chat Bot folder. Override the path if you like.
SOPS_CHROMA_DIR=
SOPS_COLLECTION=document_chunks

# Optional: override the PDF path (defaults to the file in this folder).
# SOPS_PDF_PATH=منصة_الجودة_الميدانية_SOPs.pdf

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8030
