# ── Express gateway ───────────────────────────────────────────────────────────
# NOTE: port 3000 is commonly taken by other dev servers (e.g. Next.js); the
# gateway defaults to 4000. Keep this in sync with API_CONFIG.toolsBaseUrl in
# the platform's js/config.js.
PORT=4000
# Public base URL the browser uses to reach THIS gateway (used to rewrite PDF
# download links so the browser only ever talks to Express, never the Python services).
PUBLIC_BASE_URL=http://127.0.0.1:4000
# Comma-separated list of allowed browser origins (the platform's origin).
# Use * only for local development.
CORS_ORIGIN=*

# ── PostgreSQL (Sequelize) ────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/elhamra_tools
# Set to true only if your Postgres requires SSL (e.g. managed cloud DB).
DB_SSL=false

# ── Firebase auth (token verification + role lookup) ──────────────────────────
# Service account for the project that ISSUES the platform's login tokens.
# The dashboards use firebase/config.js -> project "hajj-fd82a"; confirm and use
# that project's service account. Point this at the downloaded JSON key file.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
# Optional: the Firebase project id (falls back to the one in the service account).
FIREBASE_PROJECT_ID=hajj-fd82a
# Local-dev escape hatch ONLY: skip token verification and use a fake user.
# NEVER enable in production.
AUTH_DISABLED=false
DEV_FAKE_UID=dev-user
DEV_FAKE_ROLE=supervisor

# ── Upstream Python services ──────────────────────────────────────────────────
NEWS_AGENT_URL=http://127.0.0.1:8010
RAG_URL=http://127.0.0.1:8020
# hAJJJJ uses POST /chat {"message": "..."}; set to "ask" only for legacy haj_rag-main.
RAG_CONTRACT=chat
CHATBOT_URL=http://127.0.0.1:8030

# Timeouts (ms)
PROXY_TIMEOUT_MS=30000
REPORT_TIMEOUT_MS=600000

# News listing cache TTL (seconds)
NEWS_CACHE_TTL_SECONDS=600
